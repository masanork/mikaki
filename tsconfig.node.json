{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "local/**/*.ts",
    "design/probes/**/*.ts",
    "crates/webauthn/testdata/*.ts",
    "crates/work-git-host-worker/container.ts"
  ],
  "exclude": [
    "local/ui",
    "local/generated",
    "design/probes/node_modules",
    "design/probes/pqc/pkg",
    "design/probes/pqc/pkg-web",
    "local/conformance/support/work-source-reader.ts",
    "local/conformance/support/work-artifacts-fixture.ts",
    "local/conformance/support/work-effect-loss.ts"
  ]
}
