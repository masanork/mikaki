{
  "name": "mikaki-userinfo-claim-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "vars": {
    "MIKAKI_ISSUER": "https://mikaki.test",
  },
  "services": [
    {
      "binding": "CLAIM_STORE",
      "service": "mikaki-op-worker",
      "entrypoint": "ClaimStore",
    },
  ],
}
