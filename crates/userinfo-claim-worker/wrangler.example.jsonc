{
  "name": "mikaki-userinfo-claim-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op",
      "database_id": "REPLACE_WITH_THE_OP_DATABASE_ID"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "VAULT_USERINFO_MLKEM_A",
      "store_id": "REPLACE_WITH_SECRETS_STORE_ID",
      "secret_name": "VAULT_USERINFO_MLKEM_A"
    }
  ]
}
