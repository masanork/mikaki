{
  "name": "mikaki-userinfo-claim-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "MIKAKI_ISSUER": "https://REPLACE_WITH_ISSUER" },
  "services": [{ "binding": "CLAIM_STORE", "service": "mikaki-auth", "entrypoint": "ClaimStore" }],
  "secrets_store_secrets": [
    {
      "binding": "VAULT_USERINFO_MLKEM_A",
      "store_id": "REPLACE_WITH_SECRETS_STORE_ID",
      "secret_name": "VAULT_USERINFO_MLKEM_A",
    },
  ],
}
