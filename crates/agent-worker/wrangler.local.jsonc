{
  "name": "mikaki-agent-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_RESOURCE": "https://agent.mikaki.test/mcp",
    "AGENT_OWNER_URL": "https://mikaki.test/vault",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../worker/migrations",
      "remote": false,
    },
  ],
  "services": [
    { "binding": "AUTH_STORE", "service": "mikaki-op-agent-local", "entrypoint": "AgentStore" },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
