{
  "name": "mikaki-agent-worker",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "agent.example.com", "custom_domain": true }],
  "vars": { "AGENT_RESOURCE": "https://agent.example.com/mcp", "AGENT_OWNER_URL": "" },
  "services": [{ "binding": "AUTH_STORE", "service": "mikaki-auth", "entrypoint": "AgentStore" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
