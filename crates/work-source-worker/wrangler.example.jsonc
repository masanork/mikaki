{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikaki-work-source-reader",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "WORK_SOURCE_READER_ENABLED": "false" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "mikaki-context-dev" }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
