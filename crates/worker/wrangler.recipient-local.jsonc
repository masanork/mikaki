{
  "name": "mikaki-op-worker",
  "main": "service/entrypoint.ts",
  "compatibility_date": "2026-09-23",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    { "binding": "VAULT_BLOBS", "bucket_name": "mikaki-vault-dev" }
  ],
  "services": [
    { "binding": "USERINFO_CLAIMS", "service": "mikaki-userinfo-claim-worker" }
  ],
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] }
}
