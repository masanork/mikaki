{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "outDir": "../../../target/login-js"
  },
  "include": [
    "login.ts",
    "vault.ts",
    "admin.ts",
    "complete.ts",
    "locale.ts",
    "vault-crypto.ts",
    "vault-owner-crypto.ts",
    "vault-owner-session.ts",
    "vault-owner-store.ts",
    "vault-owner-record-store.ts",
    "vault-owner-workspace-store.ts",
    "vault-thread-archive.ts",
    "vault-note.ts",
    "attribute-commit.ts",
    "agent-crypto.ts",
    "agent-record-crypto.ts",
    "vault-record-source.ts",
    "vault-owner-disclosure.ts",
    "recipient-directory.ts",
    "vault-recipient-envelope.ts",
    "*.svelte",
    "logout.ts"
  ]
}
