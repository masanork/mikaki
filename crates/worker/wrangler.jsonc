{
  "name": "mikaki-op-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "ratelimits": [{ "name": "IDENTITY_RATE_LIMIT", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BLOBS",
      "bucket_name": "mikaki-vault-dev"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  }
}
