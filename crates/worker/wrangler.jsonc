{
  "name": "mikaki-op-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "ratelimits": [
    {
      "name": "IDENTITY_RATE_LIMIT",
      "namespace_id": "1030",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BLOBS",
      "bucket_name": "mikaki-vault-dev"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "LOGOUT_QUEUE", "queue": "mikaki-logout-wakeups-local", "remote": false }
    ],
    "consumers": [
      {
        "queue": "mikaki-logout-wakeups-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "mikaki-logout-wakeups-dlq-local",
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  }
}
