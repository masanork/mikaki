{
  "name": "mikaki-auth",
  "main": "service/entrypoint.ts",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "auth.mikaki.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "MIKAKI_WAITLIST_FROM": "no-reply@mikaki.org",
    "MIKAKI_ISSUER": "https://auth.mikaki.org",
    "MIKAKI_ANDROID_SHA256_CERT_FINGERPRINT": "FC:51:38:FE:5C:6E:05:55:AD:08:5E:4D:68:DA:F9:DB:F6:76:93:63:1E:72:C9:41:A1:7D:17:80:0D:EB:00:66",
    "WORK_SCHEMA_ENABLED": "true",
    "WORK_CHECKPOINT_NAMESPACE_ID": "37be6d239cd4460f92eff179f72ad792",
    "WORK_OWNER_API_ENABLED": "true",
    "WORK_SOURCE_API_ENABLED": "true",
    "WORK_PREPARATION_REVIEW_ENABLED": "true",
    "WORK_PREPARATION_COMPOSE_ENABLED": "true",
    "WORK_ARTIFACTS_ACCOUNT": "4b749427a0c80c547e726a42aff4b6fc",
    "WORK_ARTIFACTS_NAMESPACE": "mikaki-dev",
    "WORK_COPY_RECIPIENT": "mikaki-work-test",
    "WORK_COPY_WORKLOAD": "mikaki-work-test",
    "WORK_COPY_CONSENT_ENABLED": "true",
    "WORK_COPY_EXECUTION_ENABLED": "false",
    "WORK_CREDENTIAL_KEY_ADMIN_ENABLED": "true",
    "WORK_CREDENTIAL_KEY_FLOOR": "1",
    "WORK_COPY_BINDINGS_STAGED": "true",
    "WORK_COPY_ACTIVATION_PROFILE": "closed",
    "WORK_EFFECT_STORE_ENABLED": "false",
    "WORK_MINT_STORE_ENABLED": "false",
    "WORK_GIT_STORE_ENABLED": "false",
    "WORK_GIT_EXECUTION_ENABLED": "false",
    "WORK_PREPARATION_VERIFY_ENABLED": "false",
    "IDENTITY_ENABLED": "true",
    "IDENTITY_ISSUANCE_CLAIMS": "[\"age_over_18\"]",
    "IDENTITY_OPERATOR_CARD_KEY_SHA256": "4f165687b442164881e40b9f2d06a50a3b6e7ddeb45844fbdb7ab604dd9ee6ff",
    "IDENTITY_TRUST_POLICY_SHA256": "0bf9e8cd3d2916034333f669cfafbd3a2b0c55e3ba954020de2d4bea81dde207"
  },
  "secrets": {
    "required": [
      "OP_PRIVATE_JWK",
      "MIKAKI_READY_TOKEN",
      "WAITLIST_MAIL_KEY",
      "WORK_CREDENTIAL_KEY_V1",
      "IDENTITY_ISSUER_JWK",
      "IDENTITY_TRUSTED_KEYS"
    ]
  },
  "send_email": [
    {
      "name": "ENROLLMENT_EMAIL",
      "allowed_sender_addresses": [
        "no-reply@mikaki.org"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-auth-owner",
      "database_id": "d0258938-0d27-4110-8aa9-c82e20f3885b",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BLOBS",
      "bucket_name": "mikaki-auth-vault"
    }
  ],
  "services": [
    {
      "binding": "USERINFO_CLAIMS",
      "service": "mikaki-auth-claims"
    },
    {
      "binding": "WORK_AUTHORITY_CHECKPOINT",
      "service": "mikaki-auth-work-checkpoint",
      "entrypoint": "WorkCheckpointService"
    },
    {
      "binding": "WORK_COPY_STARTER",
      "service": "mikaki-work-copy",
      "entrypoint": "WorkCopyStarter"
    },
    {
      "binding": "WORK_COPY_INITIAL",
      "service": "mikaki-work-initial",
      "entrypoint": "WorkEffectGate"
    },
    {
      "binding": "WORK_COPY_INITIAL_RECONCILER",
      "service": "mikaki-work-initial-reconcile",
      "entrypoint": "WorkEffectReconciler"
    },
    {
      "binding": "WORK_COPY_MINT",
      "service": "mikaki-work-mint",
      "entrypoint": "WorkMintGate"
    },
    {
      "binding": "WORK_COPY_GIT",
      "service": "mikaki-work-git",
      "entrypoint": "WorkGitGate"
    },
    {
      "binding": "WORK_COPY_RECONCILER",
      "service": "mikaki-work-mint-reconcile",
      "entrypoint": "WorkMintReconciler"
    },
    {
      "binding": "WORK_COPY_CLOSER",
      "service": "mikaki-work-mint-close",
      "entrypoint": "WorkMintCloser"
    },
    {
      "binding": "WORK_COPY_VERIFIER",
      "service": "mikaki-work-preparation",
      "entrypoint": "WorkPreparationGate"
    },
    {
      "binding": "WORK_PREPARATION_EVIDENCE",
      "service": "mikaki-auth-work-checkpoint",
      "entrypoint": "WorkPreparationEvidence"
    },
    {
      "binding": "WORK_GIT_EXECUTION_CHECKPOINT",
      "service": "mikaki-auth-work-checkpoint",
      "entrypoint": "WorkGitExecutionCheckpoint"
    },
    {
      "binding": "WORK_GIT_TRANSPORT",
      "service": "mikaki-work-git-transport",
      "entrypoint": "WorkGitTransport"
    },
    {
      "binding": "WORK_MINT_REFUSAL_TRANSPORT",
      "service": "mikaki-work-mint-refusal",
      "entrypoint": "WorkMintRefusalTransport"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LOGOUT_QUEUE",
        "queue": "mikaki-logout-wakeups"
      }
    ],
    "consumers": [
      {
        "queue": "mikaki-logout-wakeups",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "mikaki-logout-wakeups-dlq",
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "ratelimits": [
    {
      "name": "IDENTITY_RATE_LIMIT",
      "namespace_id": "1031",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
