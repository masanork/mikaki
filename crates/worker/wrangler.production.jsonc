{
  "name": "mikaki-op",
  "main": "build/worker/shim.mjs",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mikaki.tossa.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "MIKAKI_ISSUER": "https://mikaki.tossa.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op",
      "database_id": "f84e650a-b4d9-42a1-9ccd-6d1b27ca74a1",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
