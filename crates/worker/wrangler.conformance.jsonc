{
  "name": "mikaki-op-conformance",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "MIKAKI_DEPLOYMENT_PROFILE": "conformance"
  },
  "queues": {
    "producers": [
      { "binding": "LOGOUT_QUEUE", "queue": "mikaki-logout-wakeups-conformance", "remote": false }
    ],
    "consumers": [
      {
        "queue": "mikaki-logout-wakeups-conformance",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "mikaki-logout-wakeups-dlq-conformance",
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-op-conformance",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ]
}
