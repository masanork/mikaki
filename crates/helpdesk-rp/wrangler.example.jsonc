{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikaki-helpdesk-rp",
  "main": "worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ISSUER": "https://mikaki.tossa.app",
    "RP_ORIGIN": "https://help.example.com",
    "CLIENT_ID": "replace-with-registered-client-id",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-helpdesk",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
