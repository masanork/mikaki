{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikaki-demo-rp",
  "main": "worker.ts",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "demo.mikaki.org",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ISSUER": "https://auth.mikaki.org",
    "RP_ORIGIN": "https://demo.mikaki.org",
    "CLIENT_ID": "77551450-ec73-4222-972d-cd912d9493d4",
    "DEMO_ONLY": "true",
  },
  "secrets": {
    "required": ["RP_PRIVATE_JWK"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-demo-rp",
      "database_id": "ce11d383-758b-4574-8bcc-7febc505a408",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "DEMO_LIMITER",
      "namespace_id": "2026100401",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
}
