{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikaki-demo-local",
  "main": "worker.ts",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "DEMO_ONLY": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikaki-demo-local",
      "database_id": "00000000-0000-0000-0000-000000000004",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "ratelimits": [
    {
      "name": "DEMO_LIMITER",
      "namespace_id": "2026100401",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": false,
  },
}
