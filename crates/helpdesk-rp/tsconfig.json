{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker.ts",
    "oidc.ts",
    "worker-configuration.d.ts",
    "worker-demo-configuration.d.ts",
    "wasm.d.ts",
    "wasm-bindings.d.ts",
    "i18n.ts",
    "demo.ts"
  ]
}
