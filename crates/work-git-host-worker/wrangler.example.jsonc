{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikaki-work-git-host-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WORK_GIT_HOST_ENABLED": "false",
    "WORK_ARTIFACTS_ACCOUNT": "SELECT_ACCOUNT",
    "WORK_ARTIFACTS_NAMESPACE": "mikaki-dev",
    "WORK_AUTHORITY_ID": "SELECT_ENROLLED_AUTHORITY",
    "WORK_GIT_DISCLOSURE_DIGEST": "SELECT_NATIVE_DISCLOSURE_DIGEST",
    "WORK_GIT_REGISTRY_SHA256": "SELECT_SEALED_REGISTRY_SHA256",
  },
  "containers": [
    {
      "name": "mikaki-work-git-host-dev",
      "scheduling_policy": "durable_object",
      "images": {
        "host": {
          "dockerfile": "SELECT_GENERATED_IMAGE/Dockerfile",
          "build_context": "SELECT_GENERATED_IMAGE",
        },
      },
      "observability": { "enabled": true, "logs": { "enabled": true } },
    },
  ],
  "durable_objects": { "bindings": [{ "name": "GIT_HOST", "class_name": "GitHostContainer" }] },
  "r2_buckets": [{ "binding": "GIT_SOURCES", "bucket_name": "select-private-git-source-bucket" }],
  "exports": {
    "GitHostContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "mikaki-work-git-host-dev",
    },
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
