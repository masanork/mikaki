{
  "name": "mikaki-local-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:policy": "node scripts/build_policy.ts",
    "build:wasm": "wasm-pack build crates/browser-wasm --target web --release --out-dir pkg -- --locked",
    "build:ui": "vite build --config local/ui/vite.config.ts",
    "build": "npm run build:policy && npm run build:wasm && npm run build:ui",
    "test:e2e": "node --test --test-concurrency=1 local/test/*.test.ts",
    "check:node": "node_modules/@typescript/native/bin/tsc --project tsconfig.node.json",
    "check:ui": "svelte-check --tsconfig local/ui/tsconfig.json --tsgo --fail-on-warnings",
    "check:worker-ui": "node_modules/@typescript/native/bin/tsc --project crates/worker/ui/tsconfig.json --noEmit && svelte-check --tsconfig crates/worker/ui/tsconfig.json --tsgo --fail-on-warnings",
    "check:product-sources": "node scripts/check_product_sources.ts",
    "test:sql": "node --test scripts/test_*_sql.test.ts",
    "check:i18n": "node scripts/check_i18n.ts",
    "generate:webauthn-interop": "node crates/webauthn/testdata/generate_interop.ts",
    "probe:recipient-envelope": "esbuild scripts/probe-recipient-envelope.ts --bundle --platform=node --format=esm --external:wrangler --outfile=local/generated/probe-recipient-envelope.mjs && node local/generated/probe-recipient-envelope.mjs",
    "format:check": "prettier --check 'local/**/*.ts' 'local/ui/src/**/*.{ts,svelte}' 'crates/worker/ui/*.{ts,svelte,json}' 'crates/webauthn/testdata/*.ts' 'scripts/*.ts' 'design/probes/**/*.ts' package.json .prettierrc.json 'tsconfig.node*.json'",
    "health": "node scripts/health.ts",
    "dev": "node local/dev.ts"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "jose": "6.2.12",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.1",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "smol-toml": "1.9.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "wrangler": "4.136.2"
  }
}
