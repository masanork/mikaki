  "reviewGroups": {
    "local-toolchain": {
      "disposition": "retained-trust-boundary",
      "rationale": "Local developer/CI tools intentionally use the selected toolchain PATH. Literal executable names and argument arrays do not invoke a shell. The operator and CI image must control PATH; running these helpers is not a sandbox for untrusted agents.",
      "count": 58
    },
    "git-object-id": {
      "disposition": "retained-protocol",
      "rationale": "SHA-1 is the existing Git object/pack format, not an authorization digest. Independent SHA-256 commitments remain required for disclosure, consent and release evidence.",
      "count": 7
    },
    "standard-identifier": {
      "disposition": "retained-protocol",
      "rationale": "SHA-1 derives an X.509/U2F certificate key identifier, UUIDv5 or macOS signing-identity lookup. It does not select SHA-1 for new signatures or token issuance.",
      "count": 5
    },
    "tpm-compatibility": {
      "disposition": "retained-compatibility",
      "rationale": "TPM nameAlg is part of the attested structure; RS1 is a bounded verification compatibility profile. Keep algorithm allow lists and ADR 0008; this is not approval for SHA-1 issuance.",
      "count": 1
    },
    "logout-event-uri": {
      "disposition": "false-positive-reviewed",
      "rationale": "This exact HTTP URI is the OpenID Back-Channel Logout events claim member name, never a network destination.",
      "count": 4
    },
    "structured-log": {
      "disposition": "false-positive-reviewed",
      "rationale": "Remote values are emitted through JSON.stringify, which escapes embedded newlines. Upstream revisions and release versions are validated before the upstream-pins report.",
      "count": 2
    },
    "policy-revision-log": {
      "disposition": "false-positive-reviewed",
      "rationale": "validateWorkerPolicyProjection verifies both revisions as 64-character SHA-256 hexadecimal identifiers before logging. These policy digests are public identifiers, not credentials.",
      "count": 1
    },
    "operator-file": {
      "disposition": "retained-trust-boundary",
      "rationale": "The explicit CLI operand selects an operator-owned local configuration, SDK, APK, policy or output. These tools do not receive remote path input and do not claim to confine an untrusted agent. Dry-run/remote selection, strict parsing and existing write guards still apply.",
      "count": 10
    },
    "apk-operand": {
      "disposition": "hardened-pending-analysis",
      "rationale": "Resolve APK and SDK operands to absolute paths and explicitly disable shell invocation. Option-looking APK names cannot become apksigner/apkanalyzer flags; regression tests exercise dash and shell-metacharacter names.",
      "count": 2
    },
    "report-create": {
      "disposition": "hardened-pending-analysis",
      "rationale": "The explicitly selected output is created exclusively with wx and mode 0600. Existing files and symlink targets cannot be overwritten; tested with disposable files.",
      "count": 1
    },
    "promotion-input": {
      "disposition": "hardened-pending-analysis",
      "rationale": "Require a direct promotion-XXXXXX child of this checkout artifacts directory, verify canonical paths and reject redirected parents or candidates before reading the manifest or supplying Wrangler operands.",
      "count": 2
    },
    "probe-log-directory": {
      "disposition": "hardened-pending-analysis",
      "rationale": "The container probe now writes under /probe/logs in the disposable container. Host logs already use a private mkdtemp directory.",
      "count": 1
    },
    "deterministic-order": {
      "disposition": "retained-deterministic-order",
      "rationale": "The reported sites compare field/name sets or produce canonical protocol/evidence ordering. Default UTF-16 ordering is intentional; localeCompare is not an appropriate replacement for deterministic canonicalization. This is not a claim that every future sort may omit a comparator.",
      "count": 89
    }
  },
