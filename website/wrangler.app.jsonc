{
  "name": "mikaki-app-links",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "main": "app-worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.mikaki.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./app-public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
