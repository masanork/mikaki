{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mikaki-local-op",
  "main": "op.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "LOCAL_ONLY": "true" },
  "assets": { "directory": "./ui/dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "mikaki-local-op", "database_id": "00000000-0000-0000-0000-000000000001", "remote": false }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": false }
}
