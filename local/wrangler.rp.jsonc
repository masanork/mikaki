{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mikaki-local-rp",
  "main": "rp.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "LOCAL_ONLY": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "mikaki-local-rp", "database_id": "00000000-0000-0000-0000-000000000002", "remote": false }],
  "observability": { "enabled": false }
}
